# Copy to .env and set your API key locally. Never put a real key in this template.
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_ALLOWED_HOSTS=api.openai.com
# Full pack replay requires privacy approval or explicit synthetic-pack authorization.
LLM_PRIVACY_APPROVED=false

# Explicit user override for this synthetic assignment pack only; does not claim ZDR.
LLM_SYNTHETIC_PACK_AUTHORIZED=false

# Same OpenAI account/key by default. Exact HTTPS hosts must be allowlisted above.
LLM_FALLBACK_MODEL=gpt-4.1-mini
LLM_FALLBACK_ENDPOINT=https://api.openai.com/v1/chat/completions
# Leave empty to reuse LLM_API_KEY. A separate provider needs its own compatible key.
LLM_FALLBACK_API_KEY=
